#!/bin/bash
set -eu -o pipefail

HYPRPERFMODE=$(hyprctl getoption animations.enabled | awk 'NR==1{print $2}')
readonly HYPRPERFMODE

if [ "$HYPRPERFMODE" = true ] ; then
    hyprctl eval "\
        hl.config({\
          animations={enabled=false},\
          decoration={rounding=0,shadow={enabled=false},blur={enabled=false},glow={enabled=false}},\
          general={gaps_in=0,gaps_out=0,border_size=1},\
        });"
    exit
fi

hyprctl reload > /dev/null
